{
  "openapi": "3.0.1",
  "info": {
    "title": "Secuitas HQ Admin Api - DEV",
    "version": "v1"
  },
  "paths": {
    "/api/v{version}/authenticate/signin": {
      "post": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Autenticate a user",
        "operationId": "SignIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v{version}/authenticate/signout": {
      "post": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Sign out a user",
        "operationId": "SignOut",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v{version}/user": {
      "get": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Returns an authenticated user",
        "description": "The user is fetch from the request by reading the cookie.",
        "operationId": "GetAuthenticatedUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v{version}/company": {
      "get": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Returns a paginated list of companies",
        "description": "Roles Required: Manage Companies",
        "operationId": "GetCompanies",
        "parameters": [
          {
            "name": "Search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "IncludeAllPages",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageNumber",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "RequestUserId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyResponsePagination"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "deprecated": true
      }
    },
    "/v{version}/company/{id}": {
      "patch": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Patch a company's VXG settings",
        "description": "Roles Required: Manage Companies",
        "operationId": "SetCompany",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompanyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v{version}/person_message_groups": {
      "get": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Returns a list of message groups for the authenticated user.",
        "description": "",
        "operationId": "GetPersonMessageGroups",
        "parameters": [
          {
            "name": "RequestUserId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PersonMessageGroupResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v{version}/person_message_groups/{id}": {
      "delete": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Deletes a message group for the authenticated user.",
        "description": "",
        "operationId": "DeletePersonMessageGroup",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/v{version}/cameras": {
      "get": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Returns a list of cameras.",
        "description": "",
        "operationId": "GetCameras",
        "parameters": [
          {
            "name": "Search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "IncludeAllPages",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageNumber",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "RequestUserId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CameraResponsePagination"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Creates a new customer/camera assocation.",
        "operationId": "CameraAssocation",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Updates a customer/camera assocation.",
        "description": "This map an existing camera to a different customer",
        "operationId": "UpdateCameraAssocation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CameraRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v{version}/cameras/{id}": {
      "patch": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Updates the camera name",
        "operationId": "UpdateCameraName",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "cameraName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Removes a customer/camera assocation",
        "operationId": "RemoveCameraAssocation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v{version}/logs": {
      "get": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Returns a list of files for viewing.",
        "description": "",
        "operationId": "GetLogFiles",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v{version}/log": {
      "get": {
        "tags": [
          "Stanley.EServices.Web5.HQ.WebAdmin"
        ],
        "summary": "Returns a file for viewing.",
        "description": "",
        "operationId": "GetLogFile",
        "parameters": [
          {
            "name": "Filename",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "RequestUserId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthenticationRequest": {
        "type": "object",
        "properties": {
          "emailAddress": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BaseResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CameraRequest": {
        "type": "object",
        "properties": {
          "cameraID": {
            "type": "integer",
            "format": "int32"
          },
          "customerID": {
            "type": "integer",
            "format": "int32"
          },
          "cameraName": {
            "type": "string",
            "nullable": true
          },
          "sourceKey": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CameraResponse": {
        "type": "object",
        "properties": {
          "cameraID": {
            "type": "integer",
            "format": "int32"
          },
          "cameraName": {
            "type": "string",
            "nullable": true
          },
          "customerID": {
            "type": "integer",
            "format": "int32"
          },
          "customerName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CameraResponsePagination": {
        "type": "object",
        "properties": {
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "currentPage": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CameraResponse"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CompanyRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "vxgCompanyGuid": {
            "type": "string",
            "nullable": true
          },
          "vxgLKey": {
            "type": "string",
            "nullable": true
          },
          "vxgEmail": {
            "type": "string",
            "nullable": true
          },
          "vxgEmailPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CompanyResponse": {
        "type": "object",
        "properties": {
          "companyID": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "vxgCompanyGuid": {
            "type": "string",
            "nullable": true
          },
          "vxgLKey": {
            "type": "string",
            "nullable": true
          },
          "vxgEmail": {
            "type": "string",
            "nullable": true
          },
          "vxgEmailPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CompanyResponsePagination": {
        "type": "object",
        "properties": {
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "currentPage": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompanyResponse"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PersonMessageGroupResponse": {
        "type": "object",
        "properties": {
          "personMessageGroupID": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "viewedOn": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "userID": {
            "type": "integer",
            "format": "int32"
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}